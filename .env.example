# Copie para .env.local. Não commite chaves reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Não há autocadastro.
# O primeiro ADM é criado fora da tela, com App Metadata { "perfil": "admin" }.
# O acesso do prestador nasce na ficha, sempre com perfil prestador.
# Sem perfil admin ou prestador, o login cai em /sem-acesso.
# Não use User Metadata para perfil: o usuário poderia se promover.
