# Copie para .env.local. Não commite chaves reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Não há autocadastro.
# No painel do Supabase, crie o usuário e grave em App Metadata:
# { "perfil": "admin" }
# ou { "perfil": "prestador" }.
# Sem um desses valores, o login cai em /sem-acesso.
# Não use User Metadata para perfil: o usuário poderia se promover.
