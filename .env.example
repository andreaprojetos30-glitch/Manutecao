# Copie para .env.local. Não commite chaves reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público usado somente na mensagem de WhatsApp.
# Não use localhost, 127.0.0.1 nem caminho. Não commite um valor real.
# No laboratório, o único valor de conferência é https://manutencao.eleva.example
# APP_PUBLIC_ORIGIN=

# Chave de 32 bytes em base64, exclusiva do servidor. Não commite o valor real.
# Não reuse a chave do Supabase e não use prefixo NEXT_PUBLIC_.
# TOKEN_LINK_CHAVE=

# Não há autocadastro.
# O primeiro ADM é criado fora da tela, com App Metadata { "perfil": "admin" }.
# O acesso do prestador nasce na ficha, sempre com perfil prestador.
# Sem perfil admin ou prestador, o login cai em /sem-acesso.
# Não use User Metadata para perfil: o usuário poderia se promover.
